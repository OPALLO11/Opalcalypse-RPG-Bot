TWITCH_USERNAME=your_twitch_bot_username
TWITCH_TOKEN=oauth:YOUR_TWITCH_BOT_OAUTH_TOKEN
TWITCH_CHANNEL=your_twitch_channel_name
TWITCH_CLIENT_ID=YOUR_TWITCH_CLIENT_ID
TWITCH_CLIENT_SECRET=YOUR_TWITCH_CLIENT_SECRET
TWITCH_BOT_ID=YOUR_TWITCH_BOT_ID
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-pro

DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL
DISCORD_ENABLED=false

TTS_ENABLED=false
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=1.2
TTS_VOLUME=0.8
TTS_MIN_MESSAGE_LENGTH=3
TTS_BLACKLIST_USERS=nightbot,streamelements,streamlabs,moobot,fossabot

OVERLAY_WEBSOCKET_PORT=8080
OVERLAY_HOST=localhost

GAME_BOSS_SPAWN_ON_START=true
GAME_BOSS_TIMER_MINUTES=20
GAME_ENABLE_WEEKLY_BOSS=true
GAME_WEEKLY_BOSS_CHANCE=0.1
GAME_ENABLE_MONTHLY_BOSS=true
GAME_MONTHLY_BOSS_CHANCE=0.05
GAME_DAMAGE_MULTIPLIER=1.0
GAME_XP_MULTIPLIER=1.0
GAME_DROP_RATE_MULTIPLIER=1.0

BITS_ART_ENABLED=true
BITS_ART_MIN_BITS_RANDOM=100
BITS_ART_MIN_BITS_CUSTOM=300
BITS_ART_DISPLAY_DURATION_SECONDS=45

STREAMERBOT_ENABLED=true
STREAMERBOT_HTTP_URL=http://127.0.0.1:7474/DoAction
STREAMERBOT_BROADCASTER_ACTION_NAME=SendBroadcasterMessage
STREAMERBOT_USE_PYTHON_WS_SERVER=false
STREAMERBOT_WS_URL=ws://127.0.0.1:8080/
STREAMERBOT_PYTHON_WS_PORT=6789

FLASK_PORT=5000
FLASK_HOST=127.0.0.1
