{
  "twitch": {
    "username": "your_twitch_bot_username",
    "oauth_token": "oauth:YOUR_TWITCH_BOT_OAUTH_TOKEN",
    "channel": "your_twitch_channel_name",
    "client_id": "YOUR_TWITCH_CLIENT_ID",
    "client_secret": "YOUR_TWITCH_CLIENT_SECRET"
  },
  "gemini": {
    "api_key": "YOUR_GEMINI_API_KEY",
    "model": "gemini-1.5-pro",
    "safety_settings": {
      "hate": "BLOCK_MEDIUM_AND_ABOVE",
      "harassment": "BLOCK_MEDIUM_AND_ABOVE",
      "sexual": "BLOCK_MEDIUM_AND_ABOVE",
      "dangerous": "BLOCK_MEDIUM_AND_ABOVE"
    }
  },
  "discord": {
    "webhook_url": "YOUR_DISCORD_WEBHOOK_URL",
    "enabled": false
  },
  "tts": {
    "enabled": false,
    "voice": "en-US-ChristopherNeural",
    "rate": 1.2,
    "volume": 0.8,
    "min_message_length": 3,
    "blacklist_users": [
      "nightbot",
      "streamelements",
      "streamlabs",
      "moobot",
      "fossabot"
    ]
  },
  "overlay": {
    "websocket_port": 8080,
    "host": "localhost"
  },
  "game": {
    "boss_spawn_on_start": true,
    "boss_timer_minutes": 20,
    "enable_weekly_boss": true,
    "weekly_boss_chance": 0.1,
    "enable_monthly_boss": true,
    "monthly_boss_chance": 0.05,
    "damage_multiplier": 1.0,
    "xp_multiplier": 1.0,
    "drop_rate_multiplier": 1.0
  },
  "bits_art": {
    "enabled": true,
    "min_bits_random": 100,
    "min_bits_custom": 300,
    "display_duration_seconds": 45,
    "random_prompts": [
      "A beautiful thank you card with flowers and sparkles, fantasy art style",
      "A cute chibi anime character saying thank you with heart eyes",
      "A fantasy wizard casting a gratitude spell with golden sparkles",
      "A kawaii cat holding a thank you sign in a flower garden",
      "An epic hero bowing in gratitude under cherry blossoms",
      "A magical forest spirit offering a glowing flower of thanks",
      "A futuristic robot displaying a heart on its holographic screen",
      "A pixel art hero throwing confetti and fireworks celebration",
      "A majestic dragon holding a thank you banner flying in the sky",
      "A steampunk inventor tipping their hat in appreciation",
      "A celestial angel spreading wings of golden light saying thanks",
      "A cute slime creature from RPG world smiling happily",
      "An underwater mermaid creating a thank you message with bubbles",
      "A samurai warrior bowing respectfully in a zen garden",
      "A phoenix rising from flames forming the words thank you",
      "A group of adventurers celebrating victory around a campfire",
      "A mystical crystal ball showing a heart-shaped thank you",
      "A fairy sprinkling stardust that forms a thank you message",
      "A treasure chest opening with golden light and gems spilling out",
      "A cute ghost saying boo-tiful thanks in a haunted castle",
      "An elf archer shooting an arrow that trails rainbow sparkles",
      "A knight in shining armor planting a flower as thanks",
      "A mystical book opening with magical letters floating out",
      "A cosmic scene with planets forming a smiley face",
      "A cute dragon hatchling holding a sparkling gem as a gift"
    ]
  },
  "streamerbot": {
    "enabled": true,
    "http_url": "http://127.0.0.1:7474/DoAction",
    "broadcaster_action_name": "SendBroadcasterMessage",
    "use_python_ws_server": false,
    "ws_url": "ws://127.0.0.1:8080/"
  }
}
